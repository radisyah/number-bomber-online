# Diisi OTOMATIS oleh integrasi Upstash Redis di Vercel (salah satu pasangan nama ini).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# atau nama lama dari Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Opsional tapi disarankan: server TURN agar koneksi langsung tetap jadi di jaringan seluler/NAT ketat ---
# Format JSON array (layanan TURN gratis: Metered, Cloudflare Calls, Xirsys, dll.):
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:NAMA.metered.live:80","username":"USER","credential":"PASS"}]

# --- Cara termudah: Metered (kredensial diambil server, key tidak bocor ke browser) ---
# METERED_APP_NAME = bagian depan domain Metered, mis. "namaapp" dari namaapp.metered.live
# METERED_API_KEY  = API key milik credential TURN (Dashboard Metered → TURN Server → credential → apiKey)
# METERED_REGION   = (opsional) mis. singapore / us_east; kosong = region default di dashboard
METERED_APP_NAME=
METERED_API_KEY=
METERED_REGION=
